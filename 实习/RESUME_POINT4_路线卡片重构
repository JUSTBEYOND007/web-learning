## 五、Adapter 2：历史数据 → FulfillmentTaskNodeDTO[]

  

**文件：** [src/pages/UnmannedVehicleNew/HistoryByCar/historyRecord.adapter.ts](src/pages/UnmannedVehicleNew/HistoryByCar/historyRecord.adapter.ts)

  

历史数据结构与实时数据完全不同，通过 Adapter 转换成 `FulfillmentTaskNodeDTO[]`，再交给 `TaskTimeline` 的 `taskNodes` prop，最终走同一套渲染路径。

  

### 5.1 ETA 文本构建：按状态分支

  

```typescript

const buildEtaText = (transportItem) => {

const { statusDesc } = transportItem || {};

  

if (statusDesc === '取消') return '未到达'; // 取消站点

  

if (statusDesc === '完成') {

const time = formatTime(transportItem?.actualFinishTime);

return time ? `${time} 已完成` : '已完成'; // e.g. "14:30 已完成"

}

  

if (statusDesc === '停靠中') {

const time = formatTime(transportItem?.actualArriveTime);

return time ? `${time} 已到达` : '已到达'; // e.g. "14:25 已到达"

}

  

if (['初始化', '已规划', '行驶中', '待执行'].includes(statusDesc)) {

const time = formatTime(transportItem?.estimateArriveTime);

const suffix = TransportStatusType[statusDesc] || '';

return time ? `${time} ${suffix}` : suffix; // e.g. "14:35 预计到达"

}

  

// 兜底：按优先级取时间字段

const fallbackTime =

formatTime(transportItem?.actualArriveTime)

|| formatTime(transportItem?.actualFinishTime)

|| formatTime(transportItem?.estimateArriveTime);

return fallbackTime

? `${fallbackTime} ${TransportStatusType[statusDesc] || statusDesc || ''}`.trim()

: (TransportStatusType[statusDesc] || statusDesc || '');

};

```

  

### 5.2 站点名称三级兜底

  

```typescript

const getAutoportTitle = (transportItem) =>

transportItem?.utpAutoportTitle // 优先：业务站点名称

|| transportItem?.positionName // 其次：地理位置名

|| transportItem?.departmentName // 再次：部门名称

|| '未命名站点'; // 兜底

```

  

### 5.3 拼装完整节点数组

  

```typescript

export const buildHistoryFulfillmentTaskNodes = (

record,

businessAreaId?: string

): FulfillmentTaskNodeDTO[] => {

const dispatchTime = formatTime(record?.dispatchTime);

  

// 起始点（从门店出发）

const startPoint: FulfillmentTaskNodeDTO = {

deliveryImageNumber: 0,

stopoverPointDetailInfoDTO: {

staId: businessAreaId || 'history-start',

staName: record?.businessAreaTitle || '起点',

title: record?.businessAreaTitle || '起点',

type: StopOverPointType.START_POINT,

eta: dispatchTime ? `${dispatchTime} 已发车` : '已发车',

},

};

  

const routeNodes = (record?.transportAutoportRecords || []).map(

(transportItem, index, arr) => ({

deliveryImageNumber: 0,

stopoverPointDetailInfoDTO: {

eta: buildEtaText(transportItem),

staId: transportItem?.utpAutoportId || `history-node-${index}`,

staName: getAutoportTitle(transportItem),

title: getAutoportTitle(transportItem),

recordStatus: RecordStatusType[transportItem?.statusDesc],

// 最后一个节点标记为终点

type: index === arr.length - 1

? StopOverPointType.END_POINT

: StopOverPointType.POST_POINT,

},

})

);

  

return [startPoint, ...routeNodes];

};

```

  

