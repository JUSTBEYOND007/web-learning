## 四、Adapter 1：实时数据 → RouteItem[]

  

**文件：** [src/pages/UnmannedVehicleNew/components/TaskTimeline/adapters.ts](src/pages/UnmannedVehicleNew/components/TaskTimeline/adapters.ts)

  

### 4.1 找当前活跃站点

  

```typescript

export const getTaskTimelineActiveIndex = (taskNodes: FulfillmentTaskNodeDTO[]) => {

// 优先找"预计到达"（行驶中，当前目标站）

const estimateIndex = taskNodes.findIndex((item) =>

item.stopoverPointDetailInfoDTO?.eta?.includes('预计')

);

if (estimateIndex > -1) return estimateIndex;

  

// 其次找"已到达"（停靠中）

const arrivedIndex = taskNodes.findIndex((item) =>

item.stopoverPointDetailInfoDTO?.eta?.includes('已到达')

);

if (arrivedIndex > -1) return arrivedIndex;

  

// 兜底：最后一个节点

return taskNodes.length - 1;

};

```

  

> **逻辑**：通过 ETA 文本中的关键词来判断当前活跃站点，而不是依赖独立的状态字段，因为后端在 `eta` 字段里已经编码了状态信息。

  

### 4.2 构建 RouteItem[]

  

```typescript

export const buildRouteItemsFromTaskNodes = (

taskNodes: FulfillmentTaskNodeDTO[],

options?: { showIndex?: boolean }

): RouteItem[] => {

if (!taskNodes?.length) return [];

  

const { showIndex = false } = options || {};

const activeIndex = getTaskTimelineActiveIndex(taskNodes);

let postCounter = 0;

  

return taskNodes.map((item, index) => {

const point = item.stopoverPointDetailInfoDTO;

const type = point?.type;

const isUpcoming = index >= activeIndex; // activeIndex 之后都是"待到达"

  

if (showIndex && type !== 'START_POINT' && type !== 'END_POINT') postCounter++;

  

const markerType = showIndex

? type === 'START_POINT' ? 'start'

: type === 'END_POINT' ? 'end'

: 'index'

: 'dot';

  

return {

id: String(point?.staId || point?.title || index),

title: point?.title || point?.staName || '--',

eta: point?.eta,

markerType,

markerLabel: showIndex ? getTaskTimelineIndexLabel(item, postCounter) : '',

pointStatus: isUpcoming ? 'active' : 'done', // activeIndex 前：done（蓝实）

lineStatus: index >= activeIndex ? 'active' : 'done', // 同上

arrowPosition: index === activeIndex ? 'point' : 'none', // 只有当前站点有箭头

rawNode: item, // 保留原始 DTO

};

});

};

```

  

