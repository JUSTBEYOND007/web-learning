## 五、核心渲染逻辑：renderOverlays + useEffect

  

### 5.1 触发时机

  

```typescript

// DeliveryMap/index.tsx:183

useEffect(() => {

if (!mapInitialized) return; // 守卫1：SDK 未就绪不渲染

if (isEmpty(trajectoryInfo)) return; // 守卫2：无数据不渲染

  

const $map = Map.getInstance();

if (!$map) return; // 守卫3：地图实例不存在

  

addOverlayConfig(); // 注册样式（幂等，重复调用无副作用）

$map.clearMap(); // 清除所有旧覆盖物

renderOverlays(trajectoryInfo); // 重新绘制

// 自适应缩放到包含所有覆盖物的视野

const overlays = $map?.getAllOverlays()?.filter(Boolean);

if (overlays?.length > 0) {

$map.setFitView(overlays);

}

}, [mapInitialized, trajectoryInfo]); // trajectoryInfo 变化就触发

```

  

**三步骤的必要性**：

- `clearMap()`：数据更新时旧覆盖物必须清除，否则新旧叠加（比如车辆标记会出现两个）

- `renderOverlays()`：按新数据重绘所有覆盖物

- `setFitView()`：数据变化后站点分布可能完全不同，需要重新计算最佳视野

  

### 5.2 renderOverlays：三类覆盖物的绘制

  

```typescript

// DeliveryMap/index.tsx:59

const renderOverlays = (data: TrajectoryInfo[]) => {

const $map = Map.getInstance();

  

const overlaysArr = data.map((item) => {

const { carPoints = [], routes = [], staPoints = [], endPoint, startPoint } = item;

  

// ① 站点编号标记（圆圈内显示序号，区分派送/揽收颜色）

const staNoMarkers = staPoints

.filter(o => Boolean(o?.wkt))

.map((staPoint, index) => {

return wktToOverlay(

staPoint.wkt, // WKT 坐标字符串

`${staPoint.staId}_${index}`, // 唯一 key

staPoint, // 原始数据（挂在覆盖物上供点击事件使用）

'sta-marker-no', // 样式 key，在 addOverlayConfig 中已注册

{

// 揽收点：绿色圆圈

// 派送点：蓝色圆圈

content: staPoint.type === StopOverPointType.PICK_POINT

? `<span style="color:#097562; background:#d6fcf5; ...">${index + 1}</span>`

: `<span style="color:#005be5; background:#d4e5ff; ...">${index + 1}</span>`,

}

);

});

  

// ② 车辆位置标记（带 ETA 气泡）

const carMarker = carPoints

.filter(o => Boolean(o?.wkt))

.map(carPoint => wktToOverlay(

carPoint.wkt,

carPoint.vehicleId,

carPoint,

`car-marker-${carPoint.status === CarStatus.Driving ? 'normal' : 'offset'}`,

{ content: transformJsxToHtml(<CarMarker data={carPoint} />) }

));

  

// ③ 路线（LINESTRING → Polyline）

const routeLines = routes

.filter(o => Boolean(o?.path))

.map(route => wktToOverlay(

route.path,

route.subRecordId || uniqueId('route-line'),

route,

`route-line-${route.status}` // 'route-line-0'=蓝, 'route-line-1'=灰

));

  

// ④ 起终点标记

const endPointMarker = endPoint?.wkt &&

wktToOverlay(endPoint.wkt, 'end-point', endPoint, 'end-point');

const startPointMarker = startPoint?.wkt &&

wktToOverlay(startPoint.wkt, 'start-point', startPoint, 'start-point');

  

return [staNoMarkers, carMarker, routeLines, endPointMarker, startPointMarker];

});

  

// 展开并添加到地图

overlaysArr.filter(Boolean).forEach(overlays => {

overlays.filter(Boolean).forEach(overlay => {

$map.add(overlay);

});

});

};

```

  

