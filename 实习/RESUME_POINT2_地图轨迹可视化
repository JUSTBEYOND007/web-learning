## 三、地图 SDK 初始化：useMapInitialize

  

```typescript

// useMapInitialize.ts — 完整代码

import AMapLoader from '@amap/amap-jsapi-loader';

import { Map, initializeMap } from '@/vendors/alife-yz-map-next';

  

export const useMapInitialize = (id: string) => {

const [mapReady, setMapReady] = useState(false);

  

useEffect(() => {

// 动态加载高德 JS SDK（异步，避免阻塞首屏）

AMapLoader.load({

key: AMapConfig.key,

version: AMapConfig.version,

}).then(async (AMap) => {

// 挂到 window 上，供 wktToOverlay 工具函数内部使用

(window as any).AMap = AMap;

(window as any)._amap_instance = null;

  

// 初始化地图实例，绑定到 id="vehicle-map" 的 DOM 节点

await initializeMap(id, {

zoom: 12,

zooms: [4, 20], // 缩放范围

mapStyle: 'amap://styles/whitesmoke', // 白烟主题（浅色）

});

  

setMapReady(true); // 标记地图就绪，触发渲染 useEffect

});

  

// 组件卸载时销毁地图实例，防止内存泄漏

return () => {

Map.destroy();

};

}, [id]); // id 不变则只初始化一次

  

return mapReady; // 外部根据此值决定何时开始渲染覆盖物

};

```

  

> **面试要点**：为什么要等 `mapReady` 之后才渲染覆盖物？

> 答：`AMapLoader.load` 是异步的，在 SDK 加载完成、地图实例创建完毕之前调用 `Map.getInstance()` 会拿到 null，导致覆盖物添加失败。`mapReady` 作为守卫条件保证时序正确。

  

