// 伪代码：首页扫码入口
function HomePage() {
  const trackClick = useTrackClick();
  const { mobileNumber } = useCurrentUser();

  async function handleScanClick() {
    trackClick('首页扫码按钮', '首页扫码按钮', String(mobileNumber));

    if (!mobileNumber) {
      navigateTo('/pages/login/index');
      return;
    }

    Taro.scanCode({
      onlyFromCamera: true,
      scanType: 'QR_CODE',
      success: async result => {
        const vehicleName =
          parseVehicleName(result.result) ||
          (await getZelosVehicleName(result.result)).name;

        clearVehiclePartitionCache();

        const orderResult = await getOrderByPhone(vehicleName, mobileNumber);
        const orderList = orderResult.dispatch.orderList || [];

        if (!orderList.length) {
          showToast('暂无货单信息');
          return;
        }

        navigateTo('/pages/orderList/index', {
          type: 'PHONE',
          vehicleName,
          mobileNumber,
        });
      },
    });
  }

  return <Button onClick={handleScanClick}>扫一扫取货</Button>;
}
```

