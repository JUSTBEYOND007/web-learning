### 0.1 自包含代码快照：全局埋点初始化

```ts
// 伪代码：初始化埋点 SDK
function getEnvironment() {
  if (process.env.NODE_ENV === 'development') {
    return 'dev';
  }

  const { miniProgram } = getAccountInfoSync();
  if (miniProgram.envVersion === 'develop') return 'dev';
  if (miniProgram.envVersion === 'trial') return 'uat';
  return 'prod';
}

function getVersion() {
  const { miniProgram } = getAccountInfoSync();
  return miniProgram.version || 'unknown';
}

const zemClient = createZEMClient({
  appKey: 'mini_pick',
  environment: getEnvironment(),
  version: getVersion(),
  enable: process.env.NODE_ENV === 'production',
  debug: getEnvironment() !== 'prod',
  volcano: {
    projectId: '火山项目 ID',
    topicId: '火山日志 topic ID',
  },
});
```

记忆点：

1. `environment` 解决环境隔离。
2. `version` 解决版本追踪。
3. `enable` 解决开发数据污染。
4. `debug` 解决非生产联调。

