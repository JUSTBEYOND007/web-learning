  const { orderList, vehicleName } = useOrderList();
  const { canClick, time, handleOpenBox } = useOpenBox();

  function handleOpenDoor(order) {
    trackClick('货单列表开门取货', '货单列表开门取货');

    const grids = order.gridNo.split(',');
    handleOpenBox(vehicleName, grids, [order.id], false);
  }

  function handleOpenGrid(order, gridNo) {
    trackClick('货单列表开格口', '货单列表开格口', String([gridNo]));
    handleOpenBox(vehicleName, [gridNo], [order.id], false);
  }

  function handleCompleteClick() {
    trackClick('货单列表完成取件', '货单列表完成取件');
    showCompleteConfirmModal();
  }

  async function handleCompleteConfirm() {
    trackClick('货单列表确认完成取件', '货单列表确认完成取件');

    const orderIds = orderList.map(order => order.id);
    await batchCompletePick(vehicleName, orderIds);

    await continueSubscribeFlowOrBackHome();
  }

  return (
    <View>
      {orderList.map(order => (
        <OrderCard
          onOpenDoor={() => handleOpenDoor(order)}
          onOpenGrid={gridNo => handleOpenGrid(order, gridNo)}
        />
      ))}

      <Button disabled={!canClick} onClick={handleCompleteClick}>
        {canClick ? '完成取件' : `完成取件(${time})`}
      </Button>
    </View>
  );
}
