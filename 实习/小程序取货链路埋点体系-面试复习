### 0.6 自包含代码快照：请求异常统一上报

```ts
// 伪代码：请求底座
async function request(config) {
  const finalConfig = await runRequestInterceptors(config);
  const response = await Taro.request(finalConfig);

  if (response.statusCode < 200 || response.statusCode >= 300) {
    zemClient.exceptionReporter.report(
      new RequestError({
        message: response.data?.error_description || response.data?.error,
        statusCode: response.statusCode,
        url: finalConfig.url,
        method: finalConfig.method,
        data: finalConfig.data,
        response: response.data,
      })
    );

    throw new RequestError('HTTP 请求失败');
  }

  response.config = finalConfig;
  return runResponseInterceptors(response);
}
```

记忆点：

1. HTTP 非 2xx 在最底层统一处理。
2. 统一带上 URL、method、data、response。
3. 页面代码不用每个接口重复写异常埋点。

### 0.7 自包含代码快照：业务异常和网络异常

```ts
// 伪代码：业务响应拦截器
function responseFulfilled(response) {
  const { success, isSuccess, data, message, errorCode } = response.data;

  if (success || isSuccess) {
    return data;
  }

  zemClient.exceptionReporter.report(
    new ServerException({
      message,
      code: errorCode,
      url: response.config.url,
      method: response.config.method,
      extra: {
        data: response.config.data,
      },
    })
  );

  showToast(message);
  throw new ServerError(message, errorCode);
}

function responseRejected(error, config) {
  try {
    zemClient.exceptionReporter.report(
      new NetworkException({
        message: error.message || error.errMsg,
        code: error.code,
        url: config.url,
        method: config.method,
        extra: {
          data: config.data,
          status: error.response?.status,
        },
      })
    );
  } catch (reportError) {
    zemClient.exceptionReporter.report(
      new UnknownException(reportError)
    );
  }

  throw normalizeNetworkError(error);
}
```

记忆点：

1. `RequestError` 看 HTTP 层。
2. `ServerException` 看 HTTP 200 但业务失败。
3. `NetworkException` 看断网、超时、小程序 request fail。
4. `UnknownException` 兜底上报过程自己的异常。

### 0.8 自包含代码快照：车辆分区路由

```ts
// 伪代码：车辆分区请求拦截器
const VEHICLE_HEADER = 'X-Partition-Vehicle';
const vehiclePartitionCache = new Map<string, Promise<Partition | null>>();

request.interceptors.request.use(async config => {
  const vehicleName = config.headers?.[VEHICLE_HEADER];
  if (!vehicleName) return config;

  const partition = await getVehiclePartitionWithCache(vehicleName);
  if (partition?.gatewayHost) {
    config.baseURL = `https://${partition.gatewayHost}`;
  }

  return config;
});

async function getVehiclePartitionWithCache(vehicleName: string) {
  let promise = vehiclePartitionCache.get(vehicleName);

  if (!promise) {
    promise = getVehiclePartition(vehicleName).catch(error => {
      vehiclePartitionCache.delete(vehicleName);
      throw error;
    });
    vehiclePartitionCache.set(vehicleName, promise);
  }

  return promise;
}

function clearVehiclePartitionCache() {
  vehiclePartitionCache.clear();
}
```

记忆点：

1. 开箱、手机号查单、完成取件都要带车辆名。
2. 请求前根据车辆查分区网关。
3. 缓存 Promise，避免并发重复查分区。
4. 扫码或输入取件码前清缓存，避免上一辆车影响下一辆车。

