## 22. 如果让你现场重构，会怎么抽 hook

可以把状态感知轮询抽成 `useStateAwarePolling`：

```ts
interface UseStateAwarePollingOptions {
  enabled: boolean;
  interval: number;
  task: () => Promise<void> | void;
}

function useStateAwarePolling({
  enabled,
  interval,
  task,
}: UseStateAwarePollingOptions) {
  const timerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const runningRef = useRef(false);

  const clearTimer = () => {
    if (timerRef.current) {
      clearTimeout(timerRef.current);
      timerRef.current = null;
    }
  };

  useEffect(() => {
    if (!enabled) {
      clearTimer();
      return;
    }

    let disposed = false;

    const loop = async () => {
      if (runningRef.current) return;
      runningRef.current = true;
      try {
        await task();
      } finally {
        runningRef.current = false;
        if (!disposed) {
          timerRef.current = setTimeout(loop, interval);
        }
      }
    };

    timerRef.current = setTimeout(loop, interval);

    return () => {
      disposed = true;
      clearTimer();
    };
  }, [enabled, interval, task]);
}
```

再抽一个 `usePageActivity`：

```ts
function usePageActivity() {
  const [active, setActive] = useState(true);

  useEffect(() => {
    const onVisibilityChange = () => setActive(!document.hidden);
    const onPageShow = () => setActive(true);
    const onPageHide = () => setActive(false);

    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('pageshow', onPageShow);
    window.addEventListener('pagehide', onPageHide);

    return () => {
      document.removeEventListener('visibilitychange', onVisibilityChange);
      window.removeEventListener('pageshow', onPageShow);
      window.removeEventListener('pagehide', onPageHide);
    };
  }, []);

  return active;
}
```

面试里不一定要说你已经抽成 hook。可以说：

> 当前项目里这套逻辑是在详情页内实现的，如果继续重构，我会把页面活跃状态和轮询调度拆成两个 hook，复用到任务进行中页，并把 `setInterval` 换成递归 `setTimeout` 或请求锁。

