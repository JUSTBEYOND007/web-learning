## 6. Adapter 3：车辆详情当前任务 -> RouteItem

文件：`Vehicle/DetailMap/components/currentTaskCard.adapter.ts`

车辆详情当前任务卡片使用 `CurrentTaskCard`：

```tsx
const routeItems = buildDetailTaskRouteItems(taskNodes);

<TaskTimeline routeItems={routeItems} showIndex={false} showEta={true} />
```

### 6.1 进度解析

```ts
const resolveRouteProgress = (
  taskNodes: FulfillmentTaskNodeDTO[]
): RouteProgress => {
  const progressIndex = taskNodes.findIndex((item) =>
    isProgressStatus(getRecordStatus(item))
  );
  if (progressIndex > -1) {
    return {
      arrowIndex: progressIndex > 0 ? progressIndex - 1 : progressIndex,
      arrowPosition: progressIndex > 0 ? 'line' : 'point',
      activeLineIndex: progressIndex > 0 ? progressIndex - 1 : -1,
      reachedIndex: progressIndex - 1,
    };
  }

  const lastDoneIndex = taskNodes.reduce((lastIndex, item, index) => (
    isDoneStatus(getRecordStatus(item)) ? index : lastIndex
  ), -1);
  if (lastDoneIndex > -1) {
    return {
      arrowIndex: lastDoneIndex,
      arrowPosition: 'point',
      activeLineIndex: -1,
      reachedIndex: lastDoneIndex,
    };
  }

  const lastArrivedIndex = findLastIndexByEta(taskNodes, '已到达');
  if (lastArrivedIndex > -1) {
    return {
      arrowIndex: lastArrivedIndex,
      arrowPosition: 'point',
      activeLineIndex: -1,
      reachedIndex: lastArrivedIndex,
    };
  }

  const estimateIndex = taskNodes.findIndex((item) =>
    getEta(item).includes('预计')
  );
  if (estimateIndex > -1) {
    return {
      arrowIndex: estimateIndex > 0 ? estimateIndex - 1 : estimateIndex,
      arrowPosition: estimateIndex > 0 ? 'line' : 'point',
      activeLineIndex: estimateIndex > 0 ? estimateIndex - 1 : -1,
      reachedIndex: estimateIndex - 1,
    };
  }

  return {
    arrowIndex: taskNodes.length - 1,
    arrowPosition: 'point',
    activeLineIndex: -1,
    reachedIndex: taskNodes.length - 1,
  };
};
```

和通用 adapter 类似，但它更强调“当前任务”的进行中状态和取消状态。

### 6.2 转成 RouteItem

```ts
export const buildDetailTaskRouteItems = (
  taskNodes?: FulfillmentTaskNodeDTO[]
): RouteItem[] => {
  if (!taskNodes?.length) return [];

  const routeProgress = resolveRouteProgress(taskNodes);

  return taskNodes.map((item, index) => {
    const point = item.stopoverPointDetailInfoDTO;
    const title = point?.title || point?.staName || '--';
    const status = getRecordStatus(item);
    const pointStatus: RouteItem['pointStatus'] = isCancelStatus(status)
      ? 'cancel'
      : index <= routeProgress.reachedIndex
        ? 'done'
        : 'pending';
    const lineStatus: RouteItem['lineStatus'] =
      index < routeProgress.reachedIndex
        ? 'done'
        : index === routeProgress.activeLineIndex
          ? 'active'
          : 'pending';
    const arrowPosition =
      index === routeProgress.arrowIndex ? routeProgress.arrowPosition : 'none';

    return {
      id: String(point?.staId || title || index),
      title,
      eta: point?.eta,
      markerType: 'dot',
      pointStatus,
      lineStatus,
      arrowPosition,
      rawNode: item,
    };
  });
};
```

这就是简历里“路线卡片复用同一渲染逻辑”的最直接证据：当前任务卡片不再自己写 dot/line/arrow 的判断，而是交给 `TaskTimeline`。

