## 5. Adapter 2：历史记录 -> FulfillmentTaskNodeDTO

文件：`HistoryByCar/historyRecord.adapter.ts`

历史接口不直接返回 `FulfillmentTaskNodeDTO[]`，而是返回历史运输记录。适配器先把它转成统一履约节点：

```ts
export const buildHistoryFulfillmentTaskNodes = (
  record,
  businessAreaId?: string
): FulfillmentTaskNodeDTO[] => {
  const dispatchTime = formatTime(record?.dispatchTime);
  const startPoint: FulfillmentTaskNodeDTO = {
    deliveryImageNumber: 0,
    stopoverPointDetailInfoDTO: {
      staId: businessAreaId || 'history-start',
      staName: record?.businessAreaTitle || '起点',
      title: record?.businessAreaTitle || '起点',
      type: StopOverPointType.START_POINT,
      eta: dispatchTime ? `${dispatchTime} 已发车` : '已发车',
    },
  };

  const routeNodes = (record?.transportAutoportRecords || []).map(
    (transportItem, index, arr) => {
      const title = getAutoportTitle(transportItem);

      return {
        deliveryImageNumber: 0,
        stopoverPointDetailInfoDTO: {
          eta: buildEtaText(transportItem),
          staId: transportItem?.utpAutoportId || `history-node-${index}`,
          staName: title,
          title,
          recordStatus: RecordStatusType[transportItem?.statusDesc],
          type:
            index === arr.length - 1
              ? StopOverPointType.END_POINT
              : StopOverPointType.POST_POINT,
        },
      };
    }
  );

  return [startPoint, ...routeNodes];
};
```

### 5.1 历史 ETA 文案适配

```ts
const buildEtaText = (transportItem) => {
  const { statusDesc } = transportItem || {};

  if (statusDesc === '取消') {
    return '未到达';
  }

  if (statusDesc === '完成') {
    const time = formatTime(transportItem?.actualFinishTime);
    return time ? `${time} 已完成` : '已完成';
  }

  if (statusDesc === '停靠中') {
    const time = formatTime(transportItem?.actualArriveTime);
    return time ? `${time} 已到达` : '已到达';
  }

  if (['初始化', '已规划', '行驶中', '待执行'].includes(statusDesc)) {
    const time = formatTime(transportItem?.estimateArriveTime);
    const suffix = TransportStatusType[statusDesc] || '';
    return time ? `${time} ${suffix}` : suffix;
  }
};
```

这解决了历史接口状态描述和 UI ETA 文案不一致的问题。

### 5.2 历史列表中批量补节点

`record-list.tsx`：

```ts
Object.values(histories)?.forEach(item => {
  item.forEach(subItem => {
    subItem.fulfillmentTaskNodeDTOS = buildHistoryFulfillmentTaskNodes(
      subItem,
      businessAreaId
    );
    subItem.title = subItem?.vkey || subItem?.udid;
    subItem.vehicleId = subItem?.udid;
    subItem.redirect = true;
  });
});
```

这样 `record-item-new` 就可以统一读 `data.fulfillmentTaskNodeDTOS`。

