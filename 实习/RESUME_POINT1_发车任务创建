## 二、react-sortable-hoc 拖拽排序

  

### 2.1 组件封装

  

```typescript

// draggable-stopover-list.tsx:42

import { SortableContainer, SortableElement } from 'react-sortable-hoc';

  

// 单个可排序站点项

export const DraggableStopoverItem = SortableElement(

(props: DraggableStopoverItemProps) => {

const { staInfo, dataArray, keyIndex, startIndex, onChangeStation } = props;

  

return (

<div className={b('station-item')} onDragStart={(e) => e.preventDefault()}>

<div className={b('station-item-content')}>

{/* 超过1个站点才显示汉堡拖拽手柄 */}

{dataArray.length > 1 && <CnIcon type="hamburger" size="small" />}

  

<div style={{ fontSize: '14px' }}>

{staInfo.staName}

</div>

  

{/* 返程点和 leastOne 时不显示删除按钮 */}

{staInfo.type === StopOverPointType.END_POINT || leastOne ? (

<div className={b('list-item-none-close-icon-holder')} />

) : (

<CnIcon

type="close"

size="small"

onClick={() => {

const tmp = dataArray.slice();

tmp.splice(keyIndex - startIndex, 1); // 按相对下标删除

onChangeStation(tmp);

}}

/>

)}

</div>

</div>

);

}

);

  

// 可排序列表容器

export const DraggableStopoverList = SortableContainer(

(props: DraggableStopoverListProps) => {

const { disable, startIndex, dataArray, edit } = props;

return (

<div className={b('station-list')}>

{dataArray?.map((o, index) => (

<DraggableStopoverItem

key={`item-${o.staId}`}

index={startIndex + index} // SortableElement 要求的全局下标

keyIndex={startIndex + index}

startIndex={startIndex}

dataArray={dataArray}

staInfo={o}

disabled={disable}

onChangeStation={(v) => edit(v)}

/>

))}

</div>

);

}

);

```

  

### 2.2 拖拽结束回调：同步三处状态

  

```typescript

// index.tsx:625 — onSortEnd

const onSortEnd = ({ oldIndex, newIndex }) => {

let newarray;

  

// 更新扁平数组（setSelectedStations 的回调形式，拿到最新值）

setSelectedStations((t) => {

newarray = arrayMoveImmutable(t, oldIndex, newIndex); // 不可变移动

setSelectedStations(newarray);

setEdit(newarray); // 触发路线规划 useEffect

return newarray;

});

  

// 同步拆分回三段式（保持业务语义）

const postStaList = newarray.filter(item => item.type === 'POST_POINT');

const pickStaList = newarray.filter(item => item.type === 'PICK_POINT');

  

isDeliveryFirst

? setStopoverPointListArray([postStaList, pickStaList, stopoverPointListArray[2]])

: setStopoverPointListArray([pickStaList, postStaList, stopoverPointListArray[2]]);

// 注意：stopoverPointListArray[2]（返程点）始终保持不变

};

```

  

> **面试要点 1**：为什么用 `arrayMoveImmutable` 而不是直接 `splice`？

> 答：`splice` 会修改原数组（mutation），React 状态更新需要新引用才能触发重渲染。`arrayMoveImmutable` 返回新数组，保证不可变性。

  

> **面试要点 2**：`startIndex` 是干什么用的？

> 答：三段式数组对应三个 `DraggableStopoverList`，每个列表内部的 `index` 从 0 开始，但 `react-sortable-hoc` 需要全局唯一下标来定位拖拽位置。`startIndex` = 前面所有段的站点数之和，使得全局下标不重叠。

  

