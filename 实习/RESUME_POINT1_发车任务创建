## 四、while + await 串行异步轮询

  

### 4.1 为什么不用 setInterval？

  

| 方式 | 问题 |

|------|------|

| `setInterval` | 不等上一个请求完成就发下一个，网络慢时请求堆积；需要 `useRef` 管理 id，`useEffect` cleanup 清除，容易泄漏 |

| `while + await` | 严格串行，上一个结束才发下一个；timeout 用 `throw` 明确抛出；逻辑集中在一个 async 函数里，清晰易读 |

  

### 4.2 完整轮询实现

  

```typescript

// index.tsx:1052 — pollWifiInfo

const pollWifiInfo = async ({

udid,

businessAreaId,

deliveryAutoPortBuildingType,

requestId,

interval = 300, // 每次间隔（ms）

maxAttempts = 10 // 最大尝试次数

}) => {

let attemptCount = 0;

let result = null;

  

while (attemptCount < maxAttempts && !result) {

try {

const res = await queryDispatchStatus({

udid,

businessAreaId,

deliveryAutoPortBuildingType,

requestId,

});

  

// NASA 调度系统状态码：2 = 调度成功，3 = 调度失败

if ([2, 3].includes(+res?.data?.nasaOpenAutotransDispatchMsg?.status)) {

result = res.data; // 拿到终态，退出循环

}

} catch (error) {

console.error(`第 ${attemptCount + 1} 次请求失败`, error?.errorMsg);

}

  

attemptCount++;

  

// 只有未拿到结果时才等待，拿到结果后直接退出

if (!result) {

await new Promise(resolve => setTimeout(resolve, interval));

}

}

  

// 超时或明确失败：抛出异常，由调用方 catch 处理

if (!result || result?.nasaOpenAutotransDispatchMsg?.status === 3) {

throw new Error('发车失败');

}

  

return result;

};

```

  

### 4.3 发车主流程：校验 → 创建 → 轮询

  

```typescript

// index.tsx:1096 — toCreateRecord

const toCreateRecord = async () => {

// 1. 组装发车参数（targetIntent 区分派送/揽收意图）

const obj = {

transportParam: {

targetAutoports: (isDeliveryFirst

? [...stopoverPointListArray[0], ...stopoverPointListArray[1]]

: [...stopoverPointListArray[1], ...stopoverPointListArray[0]]

).map(item => ({

utpAutoportId: item.staId,

targetIntent: ['POST_POINT', 'STATION', 'THIRDPOST'].includes(item?.type)

? 'WaybillPost' // 派送意图

: 'WaybillPick', // 揽收意图

})),

returnToHubParam: {

parking: stopoverPointListArray[2]?.length ? {

lineType: stopoverPointListArray[2][0]?.lineType,

utpAutoportId: stopoverPointListArray[2][0]?.utpAutoportId,

parkingSpotId: stopoverPointListArray[2][0]?.parkingSpotId,

} : null

},

fileList: fileList?.map(item => item?.ossKey), // OSS 图片 key

parcelNum: ordCnt,

},

udid,

dispatchType: dispatchType === 'loop' ? '' : 'UTP_AUTO_PORT_DISPATCH',

};

  

try {

// 2. 创建发车记录（同步，得到 requestId）

const createRes = await createRecordNew(obj);

  

// 3. 校验：requestId 不存在 或 detectPass/accept 为 false → 直接失败

if (!createRes?.data?.dispatchRequestResult?.requestId ||

String(createRes?.data?.dispatchRequestResult?.detectPass) === 'false' ||

String(createRes?.data?.dispatchRequestResult?.accept) === 'false') {

CnMessage.show({ content: createRes?.data?.dispatchRequestResult?.errorMsg || '发车失败' });

return;

}

  

// 4. 轮询调度结果（最多 15 次 × 500ms = 最长等 7.5s）

const dispatchStatus = await pollWifiInfo({

businessAreaId,

deliveryAutoPortBuildingType: ["STATION", "PICKUPPOINT", "THIRDPOST"],

udid,

requestId: createRes?.data?.dispatchRequestResult?.requestId,

interval: 500,

maxAttempts: 15,

});

  

// 5. 调度成功：跨页通知列表页刷新

if (+dispatchStatus?.nasaOpenAutotransDispatchMsg?.status === 2) {

CnMessage.show({ content: '操作成功，车辆正在启动中...' });

setIsDepartureSuccess(true);

  

// Jotai atom：通知车辆列表页该车辆状态已变化

setVehicleCreateMapRecordSuccessAtoms(map => {

const newMap = new Map(map);

newMap.set(vehicleId, true);

return newMap;

});

}

} catch (err) {

setMapLoading(false);

CnMessage.show({ content: err?.errorMsg || '发车失败' });

}

};

```

  

